{% set currentNode = node if node else null -%}
{% set isPortfolio = isPortfolioLayout if isPortfolioLayout else false -%}
{% set resolvedTitle = currentNode.seoTitle if currentNode else (seoTitle or title or catalog.site.title) -%}
{% set resolvedDescription = currentNode.seoDescription if currentNode else (seoDescription or description or (catalog.site.description if isPortfolio else '')) -%}
{% set resolvedPath = currentNode.permalink if currentNode else page.url -%}
{% set hasCanonical = (canonical != false) and (not (robots and ('noindex' in robots))) and resolvedPath -%}
{% set canonicalUrl = (catalog.site.url + resolvedPath) if hasCanonical else '' -%}
{% set ogType = 'video.other' if (currentNode and currentNode.video and currentNode.video.exportVideoObject) else ('article' if currentNode else 'website') -%}
{% set ogImage = currentNode.video.thumbnailUrl if (currentNode and currentNode.video and currentNode.video.thumbnailUrl) else catalog.site.ogImage -%}
<!DOCTYPE html>
<html lang="{{ catalog.site.lang }}">
<head>
  <meta charset="utf-8">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ catalog.site.gaMeasurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ catalog.site.gaMeasurementId }}');
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#070706">
  <title>{{ resolvedTitle }}</title>
  {% if resolvedDescription %}
  <meta name="description" content="{{ resolvedDescription }}">
  {% endif %}
  {% if robots %}
  <meta name="robots" content="{{ robots }}">
  {% endif %}
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:title" content="{{ resolvedTitle }}">
  {% if resolvedDescription %}
  <meta property="og:description" content="{{ resolvedDescription }}">
  {% endif %}
  <meta property="og:image" content="{{ ogImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ resolvedTitle }}">
  {% if resolvedDescription %}
  <meta name="twitter:description" content="{{ resolvedDescription }}">
  {% endif %}
  <meta name="twitter:image" content="{{ ogImage }}">
  {% endif %}
  <link rel="icon" type="image/svg+xml" href="{{ catalog.site.favicon }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/tokens.css">
  {% if isPortfolio %}
  <link rel="stylesheet" href="/assets/css/stage-nodes.css">
  <link rel="stylesheet" href="/assets/css/chrome-hud.css">
  {% if currentNode %}
  <script type="application/ld+json">{{ currentNode | nodeSchema(catalog) | safeJson(2) | safe }}</script>
  {% else %}
  <script type="application/ld+json">{{ catalog | homeSchema | safeJson(2) | safe }}</script>
  {% endif %}
  {% elseif schema %}
  <script type="application/ld+json">{{ schema | safeJson(2) | safe }}</script>
  {% endif %}
</head>
{% if isPortfolio %}
<body data-mode="{{ 'JOURNEY' if currentNode else 'OVERVIEW' }}" data-scene-state="static"{% if currentNode %} data-initial-node-id="{{ currentNode.id }}"{% endif %}>
  {{ content | safe }}
</body>
{% else %}
<body>
  <main class="page-shell">
    {{ content | safe }}
  </main>
</body>
{% endif %}
</html>
