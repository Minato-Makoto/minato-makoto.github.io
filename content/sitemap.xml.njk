---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{# Adapted from 11ty/eleventy-base-blog (ae47fc5) content/sitemap.xml.njk (MIT) -#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all | sitemapEntries(catalog) %}
  <url>
    <loc>{{ entry.loc }}</loc>
    {%- if entry.lastmod %}
    <lastmod>{{ entry.lastmod }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
